rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to read activities, but only your Cloud Function can write
    match /activities/{activity} {
      allow read: if true;
      allow write: if false;
    }

    // Venues and weekly series are written by Cloud Functions; activities reference them by ID
    match /venues/{venue} {
      allow read: if true;
      allow write: if false;
    }
    match /series/{series} {
      allow read: if true;
      allow write: if false;
    }

    // In-app feedback: anyone can submit a report, nobody can read or change one
    // (feedbackEmailer emails it to the team through the Admin SDK).
    match /feedback/{report} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['category', 'message', 'email', 'context', 'createdAt'])
                    && request.resource.data.category in ['bug', 'event_info', 'feature', 'other']
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 5000
                    && (!('email' in request.resource.data)
                        || (request.resource.data.email is string
                            && request.resource.data.email.size() <= 200))
                    && request.resource.data.context is map
                    && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
  }
}
