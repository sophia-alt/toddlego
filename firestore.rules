rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to read activities, but only your Cloud Function can write
    match /activities/{activity} {
      allow read: if true;
      allow write: if false;
    }

    // Venues and weekly series are written by Cloud Functions; activities reference them by ID
    match /venues/{venue} {
      allow read: if true;
      allow write: if false;
    }
    match /series/{series} {
      allow read: if true;
      allow write: if false;
    }
  }
}
